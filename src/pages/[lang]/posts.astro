---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations } from '../../i18n/ui';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const posts = (await getCollection('blog', (post) => {
    return post.slug.startsWith(`${lang}/`);
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t('posts.title')} description={t('posts.description')}>
  <section class="pb-20 pt-5">
    <h1 class="text-4xl font-bold text-accent mb-6">{t('nav.posts')}</h1>
    <div class="grid gap-8">
        {posts.map((post) => (
            <article class="border border-brown p-6 rounded-lg">
                <h2 class="text-2xl font-bold mb-2">
                    <a href={`/${lang}/blog/${post.slug.split('/')[1]}`} class="hover:text-accent transition-colors">
                        {post.data.title}
                    </a>
                </h2>
                <div class="text-sm text-muted mb-4">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString(lang, {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                        })}
                    </time>
                </div>
                <p class="mb-4">{post.data.description}</p>
            </article>
        ))}
    </div>
  </section>
</BaseLayout>
