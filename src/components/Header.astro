---
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const BASE_URL = import.meta.env.BASE_URL;
const finalBase = BASE_URL.endsWith('/') ? BASE_URL : `${BASE_URL}/`;
const base = `${finalBase}${lang}`;
const links = [
  { href: `${base}/`, label: t('nav.home') },
  { href: `${base}/career`, label: t('nav.career') },
  { href: `${base}/posts`, label: t('nav.posts') },
];
---

<header class="py-8 px-4 md:px-8 max-w-4xl mx-auto w-full flex justify-end items-center md:justify-between">
  <a href={`${base}/`} class="hidden md:block text-sm font-medium font-bold text-accent hover:text-gold transition-colors">
    DXNALE
  </a>

  <nav class="flex items-center gap-3">
    <ul class="flex gap-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm uppercase text-main hover:text-accent transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex gap-2 text-sm">
      {Object.keys(languages).map((l) => {
        const currentPath = Astro.url.pathname;
        let pathAfterBase = currentPath.startsWith(BASE_URL) ? currentPath.slice(BASE_URL.length) : currentPath;
        if (pathAfterBase.startsWith('/')) pathAfterBase = pathAfterBase.slice(1);
        
        const parts = pathAfterBase.split('/');
        
        if (parts[0] in languages) {
            parts[0] = l;
        } else {
            parts.unshift(l);
        }
        
        const href = `${finalBase}${parts.join('/')}`;
        
        return (
          <a
            href={href}
            class={`uppercase ${l === lang ? 'text-accent font-bold' : 'text-main hover:text-accent'}`}
          >
            {l}
          </a>
        );
      })}
    </div>
    <div class="flex gap-1 text-sm">
      <button id="github-button" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors" aria-label="Github-logo">
        <a href="https://github.com/dxnale" aria-label="Github profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-github" viewBox="0 0 16 16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
          </svg>
        </a>
      </button>
      <ThemeToggle />
    </div>
  </nav>
</header>
